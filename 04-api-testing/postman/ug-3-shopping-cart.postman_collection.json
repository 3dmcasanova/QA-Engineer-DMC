    {
      "name": "UG-3-TC-08 · Delete the cart",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": "{{base_URL}}api/v1/orders/{{delete_order_id}}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// TC-08 deletes its own cart, so the other cases keep working with the main one.",
              "pm.sendRequest({",
              "    url: pm.collectionVariables.get(\"base_URL\") + \"api/v1/orders\",",
              "    method: \"POST\",",
              "    header: { \"Content-Type\": \"application/json\", \"Authorization\": \"Bearer \" + pm.collectionVariables.get(\"auth_token\") },",
              "    body: { mode: \"raw\", raw: JSON.stringify({ productsList: [{ productId: 1, quantity: 2 }, { productId: 5, quantity: 2 }, { productId: 3, quantity: 1 }] }) }",
              "}, (err, res) => {",
              "    if (err || res.code !== 201) {",
              "        console.warn(\"Could not create a cart to delete\", err || res.code);",
              "        return;",
              "    }",
              "    const b = res.json();",
              "    pm.collectionVariables.set(\"delete_order_id\", b.orderId ?? b.id);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"UG-3-BUG-02 · Status code is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"UG-3-BUG-02 · The body is {\\\"ok\\\": true}\", () => pm.expect(pm.response.json().ok).to.eql(true));"
            ]
          }
        }
      ]
    },
