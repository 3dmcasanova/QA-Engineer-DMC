      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Setup · Status code is 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"auth_token\", pm.response.json().authToken);"
