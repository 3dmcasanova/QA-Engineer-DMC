    {
      "name": "UG-1-TC-01 · Add an existing product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_URL}}api/v1/grocery-bundles/{{bundle_id}}/products",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productsList\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Each case gets its own bundle, so a bundle broken by one test cannot affect the next one.",
              "pm.sendRequest({",
              "    url: pm.collectionVariables.get(\"base_URL\") + \"api/v1/grocery-bundles\",",
              "    method: \"POST\",",
              "    header: { \"Content-Type\": \"application/json\", \"Authorization\": \"Bearer \" + pm.collectionVariables.get(\"auth_token\") },",
              "    body: { mode: \"raw\", raw: JSON.stringify({ groceryBundleName: \"QA bundle \" + Date.now(), groceryCollectionId: 1 }) }",
              "}, (err, res) => {",
              "    if (err || res.code !== 201) {",
              "        console.warn(\"Could not create a new bundle\", err || res.code);",
              "        return;",
              "    }",
              "    pm.collectionVariables.set(\"bundle_id\", res.json().groceryBundleId);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"UG-1-TC-01 · Status code is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"UG-1-TC-01 · The bundle contains productId 1\", () => {",
              "    const list = pm.response.json().productsList;",
              "    pm.expect(list).to.be.an(\"array\");",
              "    pm.expect(list.map(p => p.productId)).to.include(1);",
              "});"
            ]
          }
        }
      ]
    },
